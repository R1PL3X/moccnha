# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG MOHO STOREFRONT (.env)
# Đổi tên file này thành .env khi triển khai trên máy tính hoặc máy chủ hosting
# ==============================================================================

FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=moho_storefront_secret_key_change_me_in_prod_2026
PORT=5000

# ==============================================================================
# KẾT NỐI SUPABASE CLOUD (ĐỒNG BỘ DỮ LIỆU ĐA THIẾT BỊ)
# Lấy các thông số này tại: Supabase Dashboard -> Project Settings -> API
# Nếu để trống, hệ thống sẽ tự động dùng SQLite nội bộ (moho_store.db)
# ==============================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-public-key
